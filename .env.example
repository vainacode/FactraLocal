# Copie este archivo a la configuración de entorno del equipo de producción.
POS_ENV=production
POS_DB_HOST=localhost
POS_DB_PORT=5432
POS_DB_NAME=factra_db
POS_DB_USER=pos_app
POS_DB_PASSWORD=
POS_DB_SSLMODE=require
# Secreto externo usado para cifrar la API Key de FactrAPI en PostgreSQL.
POS_FACTRAPI_ENCRYPTION_KEY=
